    {
      "parameters": {
        "jsCode": "// ============================================================\n// Nó Code do n8n — Mensagem personalizada por cliente\n// Entrada : item bruto do webhook com:\n//           - body.clientes  -> lista de clientes\n//           - investimentos  -> lista de investimentos (nível raiz)\n// Saída   : um item por cliente, com o campo \"mensagem\" pronto\n// ============================================================\n\nconst itens = $input.all();\n\n// ---------- 1) Extrair clientes e investimentos ----------\n\nlet clientes = [];\nlet investimentos = [];\n\nfor (const item of itens) {\n  const dados = item.json;\n\n  // Clientes podem estar em body.clientes (item bruto do webhook)\n  if (dados.body && Array.isArray(dados.body.clientes)) {\n    clientes = clientes.concat(dados.body.clientes);\n  }\n  // Ou diretamente em dados.clientes\n  if (Array.isArray(dados.clientes)) {\n    clientes = clientes.concat(dados.clientes);\n  }\n\n  // Investimentos podem estar no nível raiz\n  if (Array.isArray(dados.investimentos)) {\n    investimentos = investimentos.concat(dados.investimentos);\n  }\n  // Ou dentro de body\n  if (dados.body && Array.isArray(dados.body.investimentos)) {\n    investimentos = investimentos.concat(dados.body.investimentos);\n  }\n\n  // Se o item já é um cliente direto (tem email ou nome+saldo)\n  if (dados.email || (dados.nome && dados.saldo !== undefined)) {\n    clientes.push(dados);\n  }\n\n  // Se o item já é um investimento direto (tem Produto ou minimo)\n  if (dados.Produto || dados.minimo !== undefined) {\n    investimentos.push(dados);\n  }\n}\n\n// ---------- 2) Funções auxiliares ----------\n\nfunction normalizar(str) {\n  return String(str).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g, \"\").toLowerCase();\n}\n\nfunction encontrarChave(obj, opcoes) {\n  const chaves = Object.keys(obj);\n  for (const opcao of opcoes) {\n    const alvo = normalizar(opcao);\n    for (const chave of chaves) {\n      if (normalizar(chave).includes(alvo)) return chave;\n    }\n  }\n  return null;\n}\n\nfunction obterValor(obj, opcoes, padrao = \"\") {\n  const chave = encontrarChave(obj, opcoes);\n  return chave && obj[chave] !== null && obj[chave] !== undefined ? obj[chave] : padrao;\n}\n\nfunction paraNumero(valor) {\n  if (typeof valor === \"number\") return valor;\n  if (valor === null || valor === undefined) return 0;\n\n  let s = String(valor).trim();\n  s = s.replace(/R\\$/gi, \"\").replace(/\\s/g, \"\");\n  s = s.replace(/\\./g, \"\").replace(\",\", \".\");\n  const n = parseFloat(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction formatarMoeda(valor) {\n  const n = paraNumero(valor);\n  return n.toLocaleString(\"pt-BR\", { style: \"currency\", currency: \"BRL\" });\n}\n\nfunction formatarRentabilidade(valor) {\n  if (valor === null || valor === undefined || valor === \"\") return \"informação indisponível\";\n  const s = String(valor).trim();\n  if (s.includes(\"%\")) return s;\n  const n = paraNumero(valor);\n  if (Number.isFinite(n)) {\n    return n.toLocaleString(\"pt-BR\", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + \"%\";\n  }\n  return s;\n}\n\n// ---------- 3) Selecionar produto ideal para cada cliente ----------\n\nfunction selecionarProduto(cliente, listaInvestimentos) {\n  if (!listaInvestimentos.length) return null;\n\n  const perfilCliente = normalizar(obterValor(cliente, [\"perfil\", \"tipo_perfil\"], \"\"));\n  const saldo = paraNumero(obterValor(cliente, [\"saldo\", \"saldo_disponivel\"], 0));\n\n  const compativeis = listaInvestimentos.filter((p) => {\n    const perfilProduto = normalizar(obterValor(p, [\"perfil\", \"tipo_perfil\"], \"\"));\n    const minimo = paraNumero(obterValor(p, [\"minimo\", \"minima\", \"min\"], 0));\n\n    const perfilOk = !perfilCliente || !perfilProduto || perfilCliente === perfilProduto;\n    const saldoOk = saldo >= minimo;\n    return perfilOk && saldoOk;\n  });\n\n  return compativeis[0] || listaInvestimentos[0];\n}\n\n// ---------- 4) Gerar mensagem ----------\n\nfunction gerarMensagem(cliente, produto) {\n  const nome = obterValor(cliente, [\"nome\", \"cliente\", \"nome_cliente\"], \"cliente\");\n  const perfil = obterValor(cliente, [\"perfil\", \"tipo_perfil\"], \"não informado\");\n  const saldoFormatado = formatarMoeda(obterValor(cliente, [\"saldo\", \"saldo_disponivel\"], 0));\n\n  if (!produto) {\n    return `Olá, ${nome}! Identificamos seu perfil ${perfil} e saldo disponível de ${saldoFormatado}. No momento não encontramos um produto recomendado para você.`;\n  }\n\n  const nomeProduto = obterValor(produto, [\"produto\", \"nome_produto\", \"tipo_produto\", \"Produto\"], \"produto\");\n  const rentabilidade = formatarRentabilidade(obterValor(produto, [\"rentabilidade\", \"rendimento\", \"taxa\"], \"\"));\n\n  return `Olá, ${nome}! Com base no seu perfil ${perfil} e saldo disponível de ${saldoFormatado}, recomendamos o produto ${nomeProduto}, com rentabilidade de ${rentabilidade}.`;\n}\n\n// ---------- 5) Retornar um item por cliente com a mensagem ----------\n\nif (clientes.length === 0) {\n  return [{\n    json: {\n      mensagem: \"Nenhum cliente encontrado.\",\n      total_clientes: clientes.length,\n      total_investimentos: investimentos.length,\n      estrutura_recebida: itens.map(i => ({\n        chaves: Object.keys(i.json),\n        exemplo: i.json\n      }))\n    }\n  }];\n}\n\nconst resultado = clientes.map((cliente) => {\n  const produto = selecionarProduto(cliente, investimentos);\n\n  return {\n    json: {\n      ...cliente,\n      mensagem: gerarMensagem(cliente, produto),\n      produto_selecionado: produto ? obterValor(produto, [\"produto\", \"nome_produto\", \"tipo_produto\", \"Produto\"], \"\") : \"\",\n      rentabilidade_selecionada: produto ? obterValor(produto, [\"rentabilidade\", \"rendimento\", \"taxa\"], \"\") : \"\"\n    }\n  };\n});\n\nreturn resultado;\n"
      },
