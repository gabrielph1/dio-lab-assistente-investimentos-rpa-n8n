    {
      "parameters": {
        "jsCode": "// ============================================================\n// Nó Code do n8n — Processa CSV de investimentos\n// Entrada : saída do nó HTTP Request (CSV como texto)\n// Saída   : um único item contendo a lista completa de investimentos\n//           (cada investimento tem indice, mínimo normalizado e dados originais)\n// ============================================================\n\nfunction parseCSV(texto) {\n  const linhas = String(texto)\n    .split(/\\r?\\n/)\n    .map((l) => l.trim())\n    .filter((l) => l !== \"\");\n\n  if (linhas.length === 0) return [];\n\n  const headers = linhas[0].split(\",\").map((h) => h.trim());\n\n  return linhas.slice(1).map((linha) => {\n    // Split que respeita campos entre aspas (\"a,b,c\")\n    const valores = linha\n      .split(/,(?=(?:[^\"]*\"[^\"]*\")*[^\"]*$)/)\n      .map((v) => v.replace(/^\"|\"$/g, \"\").trim());\n\n    const obj = {};\n    headers.forEach((h, i) => {\n      obj[h] = valores[i] ?? \"\";\n    });\n    return obj;\n  });\n}\n\nfunction normalizaMoeda(valor) {\n  if (typeof valor === \"number\") return valor;\n  if (valor === null || valor === undefined) return 0;\n\n  let s = String(valor).trim();\n\n  // \"R$ 1.000,00\" -> \"1000.00\" -> 1000\n  // Regra brasileira: ponto = milhar, vírgula = decimal\n  s = s\n    .replace(/R\\$/gi, \"\")\n    .replace(/[-\\s]/g, \"\")\n    .replace(/\\./g, \"\")\n    .replace(\",\", \".\");\n\n  const n = parseFloat(s);\n  return Number.isFinite(n) ? n : 0;\n}\n\nfunction encontrarChaveMinimo(obj) {\n  return Object.keys(obj).find((k) => {\n    const n = k\n      .toLowerCase()\n      .normalize(\"NFD\")\n      .replace(/[\\u0300-\\u036f]/g, \"\");\n    return (\n      n.includes(\"minimo\") ||\n      n.includes(\"minima\") ||\n      n === \"min\"\n    );\n  });\n}\n\n// ---------- 1) Pegar o CSV como texto vindo do HTTP Request ----------\n// Caso seu n8n seja antigo, troque $input.first().json por items[0].json\nconst primeiroItem = $input.first().json;\n\nlet csv = primeiroItem.data ?? primeiroItem.body ?? primeiroItem;\n\n// Se o HTTP Request devolveu um Buffer (Response Format: File)\nif (typeof csv === \"object\" && csv !== null && Buffer.isBuffer(csv)) {\n  csv = csv.toString(\"utf8\");\n}\n\n// ---------- 2) Converter o texto em linhas/objetos ----------\nconst linhas = parseCSV(csv);\n\n// ---------- 3) Normalizar o \"mínimo\" para número e montar a lista ----------\nconst investimentos = linhas.map((linha, indice) => {\n  const chave = encontrarChaveMinimo(linha) || \"minimo\";\n\n  return {\n    indice, // 0, 1, 2...\n    ...linha,\n    minimo: normalizaMoeda(linha[chave]), // número pronto pra usar\n    [`${chave}_original`]: linha[chave] ?? \"\", // preserva o texto original (opcional)\n  };\n});\n\n// ---------- 4) Retornar a lista inteira em UM item ----------\n// Assim todos os próximos nós recebem a array completa de uma vez.\n// No próximo nó, acesse a lista com $json.investimentos.\nreturn [{ json: { investimentos } }];\n"
      },
